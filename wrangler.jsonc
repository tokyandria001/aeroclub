{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aeroclub",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aeroclub",
      "database_id": "3415d588-abe1-4b93-9de5-df12114a7189",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
